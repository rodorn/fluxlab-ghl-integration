# Storage backend: csv | sqlite | gsheet   (default: csv)
SINK=csv
CSV_PATH=data/leads.csv
SQLITE_PATH=data/leads.db

# Google Sheets (only when SINK=gsheet)
GSHEET_ID=
GSHEET_WORKSHEET=Leads
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Forwarding to an external API (leave FORWARD_URL empty to disable)
FORWARD_URL=
FORWARD_TOKEN=
FORWARD_RETRIES=3
FORWARD_TIMEOUT=10

# Inbound webhook HMAC verification (leave WEBHOOK_SECRET empty to disable).
# The caller must send HMAC-SHA256(secret, raw_body) in the header below.
WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

# Outbound push into GoHighLevel API v2 (leave GHL_API_KEY empty to disable).
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_TIMEOUT=10
GHL_RETRIES=3

LOG_LEVEL=INFO
